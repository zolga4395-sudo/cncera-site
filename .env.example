# ============================================
# n8n Workflow Configuration
# Combined RSS & Visa Monitor
# ============================================

# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# ============================================
# FIRECRAWL API
# Get your key at: https://firecrawl.dev
# ============================================
FIRECRAWL_API_KEY=fc-your-api-key-here

# ============================================
# TELEGRAM BOT
# Get token from: @BotFather
# ============================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_RSS_CHAT_ID=-1001234567890

# ============================================
# SUPABASE
# Get from: https://app.supabase.com/project/_/settings/api
# ============================================
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# RSS FEED CONFIGURATION
# ============================================
RSS_FEED_URL=https://techcrunch.com/category/artificial-intelligence/feed/
RSS_CHECK_INTERVAL_HOURS=3
RSS_WAIT_BETWEEN_ITEMS_SECONDS=5

# ============================================
# FIRECRAWL TIMEOUTS (milliseconds)
# ============================================
FIRECRAWL_RSS_TIMEOUT=60000
FIRECRAWL_VISA_TIMEOUT=45000
FIRECRAWL_WAIT_FOR=3000

# ============================================
# POST FORMATTING
# ============================================
MAX_POST_LENGTH=1000
MAX_CONTACTS_TO_SHOW=3

# ============================================
# VISA SEARCH CONFIGURATION
# ============================================
VISA_SEARCH_LIMIT=5
VISA_SEARCH_DOMAIN=site:uz

# ============================================
# n8n WEBHOOK CONFIGURATION
# ============================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/telegram

# ============================================
# DATABASE CLEANUP (optional)
# ============================================
CLEANUP_PROCESSED_URLS_DAYS=30
CLEANUP_VISA_QUERIES_DAYS=90

# ============================================
# MONITORING (optional)
# ============================================
ENABLE_ERROR_NOTIFICATIONS=true
ERROR_NOTIFICATION_CHAT_ID=-1001234567890

# ============================================
# RATE LIMITING (optional)
# ============================================
MAX_RSS_ITEMS_PER_RUN=50
MAX_VISA_QUERIES_PER_HOUR=100
