# CNCera Configuration
# Скопируйте в .env и заполните своими значениями

# OpenAI API Key для ИИ функций
# Получите на https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Путь к FreeCADCmd (если не в PATH)
# Windows: FREECADCMD_PATH=C:\Program Files\FreeCAD 0.21\bin\FreeCADCmd.exe
# Linux: FREECADCMD_PATH=/usr/bin/FreeCADCmd
# macOS: FREECADCMD_PATH=/Applications/FreeCAD.app/Contents/MacOS/FreeCADCmd
FREECADCMD_PATH=

# Настройки Flask (опционально)
FLASK_ENV=development
FLASK_DEBUG=true