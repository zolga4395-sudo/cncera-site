# ==============================================
# N8N Competitor Price Scraper - Environment Variables
# ==============================================
# 
# Скопируйте этот файл в .env и заполните реальными значениями
# Либо настройте переменные окружения в n8n UI:
# Settings → Environments → Add Variable
#

# ----------------------------------------------
# TELEGRAM
# ----------------------------------------------
# ID чата для отправки уведомлений
# Для получения: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# Для групп начинается с "-", например: -1001234567890
DUMMY_TELEGRAM_CHAT_ID="-1001234567890"

# ----------------------------------------------
# NOTION
# ----------------------------------------------
# ID базы данных с конкурентами
# Находится в URL: https://notion.so/workspace/<DATABASE_ID>?v=...
DUMMY_NOTION_DB_ID="abc123def456ghi789jkl012mno345pq"

# ----------------------------------------------
# WEBHOOK
# ----------------------------------------------
# URL Webhook для Workflow B (RAG API)
# Получите после активации Workflow B в n8n
# Формат: https://your-n8n-instance.com/webhook/rag-analysis
DUMMY_WEBHOOK_B_URL="https://your-n8n-instance.com/webhook/rag-analysis"

# ----------------------------------------------
# CSS СЕЛЕКТОРЫ ДЛЯ ПАРСИНГА
# ----------------------------------------------
# CSS селектор для извлечения цены
# Можно указать несколько через запятую для fallback
# Примеры: ".price", "#product-price", "[data-price]"
DUMMY_CSS_SELECTOR_PRICE=".price, .product-price, [data-price]"

# CSS селектор для извлечения описания товара
# Примеры: ".description", ".product-info", "#description"
DUMMY_CSS_SELECTOR_DESCRIPTION=".description, .product-description, .product-info"

# ----------------------------------------------
# ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ
# ----------------------------------------------

# Таймаут HTTP запросов (в миллисекундах)
# По умолчанию: 30000 (30 секунд)
# HTTP_TIMEOUT=30000

# Максимальное количество повторных попыток при ошибке
# По умолчанию: 3
# HTTP_MAX_RETRIES=3

# Порог изменения цены для уведомлений (в процентах)
# По умолчанию: 5
# PRICE_CHANGE_THRESHOLD=5

# User-Agent для HTTP запросов (если сайты блокируют дефолтный)
# USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# ----------------------------------------------
# ПРИМЕЧАНИЯ
# ----------------------------------------------
# 
# 1. Credentials (API Keys) настраиваются в n8n UI:
#    - NOTION_API
#    - SUPABASE_API
#    - ANTHROPIC_API
#    - OPENAI_API
#    - TELEGRAM_API
#
# 2. Для безопасности используйте n8n Environment Variables
#    вместо .env файла в production
#
# 3. CSS селекторы нужно обновлять при изменении структуры сайтов
#