      "id": "bd6885b6-c102-4254-aa0e-d2ab092895a8",
      "name": "Firecrawl: Поиск посольств",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-64, 640]
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json || {};\nconst items = res.data || res.results || [];\nconst chatId = $input.first().json.chatId;\nconst query = $input.first().json.query;\n\nif (!Array.isArray(items) || items.length === 0) {\n  return {\n    found: false,\n    chatId,\n    query\n  };\n}\n\nconst score = u => {\n  const url = (u.url || u.link || '').toLowerCase();\n  let s = 0;\n  if (url.includes('.uz')) s += 3;\n  if (url.includes('vfsglobal')) s += 3;\n  if (url.includes('visametric')) s += 3;\n  if (url.includes('embassy') || url.includes('mfa')) s += 2;\n  if (url.includes('consulate')) s += 2;\n  return {\n    url: url.startsWith('http') ? (u.url || u.link) : ('https://' + (u.url || u.link)),\n    s\n  };\n};\n\nconst ranked = items.map(score).filter(x => x.url).sort((a, b) => b.s - a.s);\n\nreturn {\n  found: true,\n  url: ranked[0].url,\n  chatId,\n  query\n};"
      },
