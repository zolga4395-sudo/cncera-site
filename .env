# API Keys for AI Services
# Замените значения ниже на ваши настоящие API ключи
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
XAI_API_KEY=your-xai-api-key-here

# FreeCAD Configuration
FREECAD_CMD=FreeCADCmd
FREECADCMD_PATH=/usr/bin/FreeCADCmd

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True

# Note: Для полной функциональности AI чата замените API ключи выше на настоящие
# Приложение будет работать и без них, но AI функции будут недоступны