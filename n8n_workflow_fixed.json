    {
      "id": "check-slots-cron",
      "name": "Проверка слотов (Cron)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 910],
      "parameters": {
        "jsCode": "const md = $input.first().json?.data?.markdown || '';\nconst yes = /(appointment|book|signup|enroll|next\\s+date|available|open\\s*slot|запись|доступн|свободн)/i.test(md);\n\nreturn {\n  hasSlots: !!yes,\n  url: $input.first().json.url,\n  chatId: $input.first().json.chatId,\n  query: $input.first().json.query\n};"
      }
    },
