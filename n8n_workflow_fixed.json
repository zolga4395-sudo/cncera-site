    {
      "id": "code-pick-url-cron",
      "name": "Выбрать URL (Cron)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 910],
      "parameters": {
        "jsCode": "const res = $input.first().json || {};\nconst items = res.data || res.results || [];\n\nif (!Array.isArray(items) || items.length === 0) {\n  return {\n    found: false,\n    chatId: $input.first().json.chatId,\n    query: $input.first().json.query\n  };\n}\n\nconst score = u => {\n  const url = (u.url || u.link || '').toLowerCase();\n  let s = 0;\n  if (url.includes('.uz')) s += 3;\n  if (url.includes('vfsglobal')) s += 3;\n  if (url.includes('visametric')) s += 3;\n  if (url.includes('embassy') || url.includes('mfa')) s += 2;\n  if (url.includes('consulate')) s += 2;\n  return {\n    url: url.startsWith('http') ? (u.url || u.link) : ('https://' + (u.url || u.link)),\n    s\n  };\n};\n\nconst ranked = items.map(score).filter(x => x.url).sort((a, b) => b.s - a.s);\n\nreturn {\n  found: true,\n  url: ranked[0].url,\n  chatId: $input.first().json.chatId,\n  query: $input.first().json.query\n};"
      }
    },
    {
      "id": "scrape-embassy-cron",
      "name": "Firecrawl: Страница (Cron)",
